{
  "name": "resume-analyzer-desktop",
  "version": "1.0.0",
  "description": "Desktop version of the Resume Analyzer",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "electron:dev": "concurrently \"npm run dev:server\" \"wait-on http://localhost:5000/api/health && wait-on http://localhost:5173 && electron .\"",
    "build:client": "cd client && npm run build",
    "electron:build": "npm run build:client && electron-builder"
  },
  "build": {
    "appId": "com.resumeanalyzer.desktop",
    "productName": "Resume Analyzer",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server/.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resume Analyzer"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  }
}